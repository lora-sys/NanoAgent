# SmartHome AI 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 应用程序配置
NODE_ENV=production
REACT_APP_API_BASE_URL=https://api.smarthome-ai.com
REACT_APP_VERSION=1.0.0

# 联系表单配置（第三方服务）
# 选项 1: Formspree
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# 选项 2: EmailJS
REACT_APP_EMAILJS_SERVICE_ID=your-service-id
REACT_APP_EMAILJS_TEMPLATE_ID=your-template-id
REACT_APP_EMAILJS_PUBLIC_KEY=your-public-key

# 选项 3: 自定义后端 API
REACT_APP_CONTACT_API_ENDPOINT=https://your-backend.com/api/contact

# 分析工具（可选）
REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX
REACT_APP_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# 地图服务（如需展示位置）
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 安全配置
REACT_APP_CSP_REPORT_URI=https://your-csp-report-endpoint.com/report

# 注意：
# 1. 不要在此文件中存储真实的 API 密钥或密码
# 2. 生产环境请使用环境变量管理服务（如 Vercel Environment Variables）
# 3. .env 文件应添加到 .gitignore，不要提交到版本控制
